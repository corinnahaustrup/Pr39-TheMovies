<Window x:Class="Pr39_TheMovies.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pr39_TheMovies"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <!-- Kunde navn -->
        <Label Content="Kundenavn:" HorizontalAlignment="Left" Margin="22,42,0,0" VerticalAlignment="Top"/>
        <TextBox HorizontalAlignment="Left" Margin="98,46,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120" TextChanged="TextBox_TextChanged"/>
        
      <!-- Overskrift-->
        <TextBlock HorizontalAlignment="Left" Margin="22,21,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="16" FontWeight="Bold" FontFamily="Monotype Corsiva" ><Run Text="The Movies - "/><Run Language="da-dk" Text="annuller "/></TextBlock>
        <Label Content="Telefon nr.:" HorizontalAlignment="Left" Margin="24,75,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.547,-0.114"/>
        <TextBox HorizontalAlignment="Left" Margin="98,79,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120" TextChanged="TextBox_TextChanged"/>
        <TextBox HorizontalAlignment="Left" Margin="98,117,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120" TextChanged="TextBox_TextChanged"/>
        <Label Content="E-mail:" HorizontalAlignment="Left" Margin="35,108,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.547,-0.114"/>

    </Grid>
</Window>
